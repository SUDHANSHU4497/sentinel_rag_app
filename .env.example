# Copy this file to .env and fill in your own values. Never share or commit .env.

# The SENTINEL tables folder (or the zip). Only the load scripts read it.
DATA_PATH=C:\Users\sudha\Downloads\Sentinel project data\sentinel_data\tables

# ---------- transactions + features: "mongodb" (task 1) or "supabase" ----------
STORE=mongodb
# local (docker compose) or Atlas: mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=sentinel
# which splits load_mongo.py loads: validation (default), "validation,holdout" or all
LOAD_SPLITS=validation
# only for STORE=supabase (same URL and key as ingest.py all)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_SCHEMA=public

# ---------- device / customer graph: Neo4j (task 2) ----------
# Docker: neo4j://localhost:7687   Aura: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sentinel123
# payments load_neo4j.py loads: the validation split plus 90 days of history
GRAPH_FROM=2025-08-01
GRAPH_TO=2026-01-01

# ---------- policy chunks: Qdrant (task 4) + Gemini Embedding 2 ----------
# Docker: http://localhost:6333 (no key)   Cloud: https://xxxx.region.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION=sentinel_docs
EMBED_PROVIDER=euron
EMBED_MODEL=gemini-embedding-2
EURI_API_KEY=your-euri-api-key
EURI_BASE_URL=https://api.euron.one/api/v1/euri
GOOGLE_API_KEY=your-google-api-key

# ---------- LLM that writes the explanation ----------
# euron: any chat model on the EURI gateway (gpt-4.1-mini was used for the saved test run)
# google: a Gemini model name, with GOOGLE_API_KEY
LLM_PROVIDER=euron
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0

API_URL=http://127.0.0.1:8000
OUTPUT_DIR=outputs
